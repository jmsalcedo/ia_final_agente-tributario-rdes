# ============================================================
# Variables de entorno del Agente Tributario Autónomo
# Copia este archivo a .env y rellena los valores
# ============================================================

# ---------- PROVEEDOR LLM ----------
# El sistema usa Groq por defecto (gratis, sin tarjeta, rápido).
# Alternativa: HuggingFace (limitado en gratuito desde 2025).
# Si no configuras NINGUNO, el sistema funciona en modo demo.

# OPCIÓN A (RECOMENDADA): Groq — https://console.groq.com
# 1. Crea cuenta gratuita (con Google o GitHub)
# 2. API Keys → Create API Key
# 3. Copia la clave aquí (empieza por "gsk_")
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui

# Modelo Groq a usar (otros: llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_MODEL_ID=llama-3.1-8b-instant

# OPCIÓN B (FALLBACK): Hugging Face — https://huggingface.co/settings/tokens
# Solo se usa si GROQ_API_KEY no está configurado.
HF_API_TOKEN=hf_tu_token_aqui
HF_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3

# Forzar un proveedor específico ("auto", "groq", "huggingface", "demo")
LLM_PROVIDER=auto

# ---------- EMBEDDINGS ----------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---------- CONFIGURACIÓN GENERAL ----------
MAX_RETRIEVAL_DOCS=4
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800
CHROMA_PERSIST_DIR=./chroma_db

# Modo: production | demo
APP_MODE=production
